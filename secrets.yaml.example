# Copy this file to secrets.yaml and replace the example values.
# Never commit your real secrets.yaml file to GitHub.

wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Used by the camera proxy requests in waveshare-home-panel.yaml.
ha_camera_authorization: "Bearer YOUR_HOME_ASSISTANT_LONG_LIVED_ACCESS_TOKEN"
